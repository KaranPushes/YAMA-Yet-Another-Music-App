# Environment configuration for YAMA Music Server
# Copy this file to .env and adjust values if needed

# Server Port (outside 8080-9000 range)
SERVER_PORT=7080
HOST_SERVER_PORT=7080

# Ngrok Permanent Domain (e.g. your-subdomain.ngrok-free.app or your-subdomain.ngrok.app)
NGROK_DOMAIN=

# PostgreSQL Configuration
POSTGRES_DB=yama_music
POSTGRES_USER=yama_user
POSTGRES_PASSWORD=yama_secure_password_change_me
POSTGRES_PORT=5433

# Spring Datasource Configuration (internal container network uses 'postgres' host)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/yama_music
SPRING_DATASOURCE_USERNAME=yama_user
SPRING_DATASOURCE_PASSWORD=yama_secure_password_change_me

# Paths inside container
MUSIC_LIBRARY_PATH=/music
ARTWORK_PATH=/artwork

# Host storage mounts (relative to music-server directory)
HOST_MUSIC_DIR=./music
HOST_ARTWORK_DIR=./artwork

# Savify Acquisition Engine (Optional Spotify Developer credentials for metadata)
# https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

